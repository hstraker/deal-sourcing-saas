// Comparables Configuration - User-specific settings for comparable property searches
model ComparablesConfig {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  searchRadius         Int      @default(3) @map("search_radius") // miles
  maxResults           Int      @default(5) @map("max_results") // number of comparables
  maxAgeMonths         Int      @default(12) @map("max_age_months") // max age of sold properties
  bedroomTolerance     Int      @default(1) @map("bedroom_tolerance") // ±N bedrooms
  includePropertyTypes String[] @map("include_property_types") // empty = all types
  minConfidenceScore   Decimal  @default(0.7) @map("min_confidence_score") @db.Decimal(3, 2) // 0.0 to 1.0

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("comparables_config")
}

// Comparable Property - Individual sold property used for comparison
model ComparableProperty {
  id           String     @id @default(uuid())
  vendorLeadId String     @map("vendor_lead_id")
  vendorLead   VendorLead @relation(fields: [vendorLeadId], references: [id], onDelete: Cascade)

  // Property Details
  address      String
  postcode     String?
  salePrice    Decimal  @map("sale_price") @db.Decimal(10, 2)
  saleDate     DateTime @map("sale_date")
  bedrooms     Int?
  bathrooms    Int?
  propertyType String?  @map("property_type")
  squareFeet   Int?     @map("square_feet")

  // Location & Market Data
  distance        Decimal? @db.Decimal(5, 2) // miles from target property
  daysOnMarket    Int?     @map("days_on_market")
  priceReductions Int      @default(0) @map("price_reductions")

  // Rental Data (from PropertyData API)
  monthlyRent           Decimal? @map("monthly_rent") @db.Decimal(10, 2) // Average monthly rent
  weeklyRent            Decimal? @map("weekly_rent") @db.Decimal(10, 2) // Average weekly rent
  rentalYield           Decimal? @map("rental_yield") @db.Decimal(5, 2) // Annual yield percentage
  rentalYieldMin        Decimal? @map("rental_yield_min") @db.Decimal(5, 2) // Min yield (70% confidence range)
  rentalYieldMax        Decimal? @map("rental_yield_max") @db.Decimal(5, 2) // Max yield (70% confidence range)
  areaAverageRent       Decimal? @map("area_average_rent") @db.Decimal(10, 2) // Area average for comparison

  // Source Information
  listingSource       String? @map("listing_source") // 'rightmove', 'zoopla', 'onthemarket', 'multiple'
  listingUrl          String? @map("listing_url") @db.Text // Primary portal link (e.g., Rightmove)
  listingUrlSecondary String? @map("listing_url_secondary") @db.Text // Secondary portal link (e.g., Zoopla)
  propertyDataId      String? @map("propertydata_id") // PropertyData property ID

  // Analysis
  confidence          Decimal  @default(1.0) @db.Decimal(3, 2) // 0.0 to 1.0 confidence score
  notes               String?  @db.Text

  // Sourcer overrides
  excluded            Boolean  @default(false)                   // exclude from avg calc
  manualPriceOverride Decimal? @map("manual_price_override") @db.Decimal(10, 2) // override sale price for avg

  // Metadata
  fetchedAt DateTime @default(now()) @map("fetched_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([vendorLeadId])
  @@index([postcode])
  @@index([saleDate])
  @@index([fetchedAt])
  @@index([rentalYield])
  @@map("comparable_properties")
}

// Comparables Snapshot - Historical tracking of comparables over time
model ComparablesSnapshot {
  id           String     @id @default(uuid())
  vendorLeadId String     @map("vendor_lead_id")
  vendorLead   VendorLead @relation(fields: [vendorLeadId], references: [id], onDelete: Cascade)

  snapshotDate     DateTime @map("snapshot_date")
  avgPrice         Decimal? @map("avg_price") @db.Decimal(10, 2)
  comparablesCount Int      @map("comparables_count")
  searchRadius     Int      @map("search_radius")
  confidence       String? // 'HIGH', 'MEDIUM', 'LOW'
  data             Json? // Full comparables data snapshot

  createdAt DateTime @default(now()) @map("created_at")

  @@index([vendorLeadId])
  @@index([snapshotDate])
  @@map("comparables_snapshots")
}

// Investor Pack Templates - Customizable templates for generating investor packs
model InvestorPackTemplate {
  id          String   @id @default(uuid())
  name        String // e.g., "Premium Template", "Quick Overview", "Detailed Analysis"
  description String?  @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")

  // Template Type
  templateType String @default("single") @map("template_type") // '4-part' or 'single'

  // Template Configuration
  coverStyle     String?  @map("cover_style") // 'modern', 'classic', 'minimal' (for single templates)
  colorScheme    String   @default("blue") @map("color_scheme") // 'blue', 'green', 'purple', 'gold', 'dark'
  orientation    String   @default("landscape") // 'landscape' or 'portrait'
  // Company info now comes from global CompanyProfile table

  // Single Template Configuration (for backward compatibility)
  sections Json @default("[]")
  metricsConfig Json @default("{}") @map("metrics_config")

  // 4-Part Template Configuration (The Investables Method)
  part1Enabled  Boolean @default(true) @map("part1_enabled")
  part1Sections Json    @default("[]") @map("part1_sections")
  part2Enabled  Boolean @default(true) @map("part2_enabled")
  part2Sections Json    @default("[]") @map("part2_sections")
  part3Enabled  Boolean @default(true) @map("part3_enabled")
  part3Sections Json    @default("[]") @map("part3_sections")
  part4Enabled  Boolean @default(true) @map("part4_enabled")
  part4Sections Json    @default("[]") @map("part4_sections")
  includeRiskWarnings Boolean @default(true) @map("include_risk_warnings")

  // Custom Fields
  customFields Json? @map("custom_fields") // Additional user-defined fields

  // Usage Statistics
  usageCount Int      @default(0) @map("usage_count")
  lastUsedAt DateTime? @map("last_used_at")

  // Ownership
  createdById String? @map("created_by")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  generatedPacks InvestorPackGeneration[]

  @@index([isDefault])
  @@index([isActive])
  @@index([createdById])
  @@map("investor_pack_templates")
}

// Investor Pack Generation Log - Track all generated investor packs
model InvestorPackGeneration {
  id              String   @id @default(uuid())
  templateId      String?  @map("template_id")
  template        InvestorPackTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Source
  vendorLeadId    String?  @map("vendor_lead_id")
  dealId          String?  @map("deal_id")

  // Property Info (snapshot at generation time)
  propertyAddress String   @map("property_address")
  askingPrice     Decimal  @map("asking_price") @db.Decimal(10, 2)

  // Generation Details
  generatedById   String   @map("generated_by")
  fileSize        Int?     @map("file_size") // bytes
  pageCount       Int?     @map("page_count")

  // Delivery
  sentToEmail     String?  @map("sent_to_email")
  sentAt          DateTime? @map("sent_at")
  viewedAt        DateTime? @map("viewed_at")
  downloadedAt    DateTime? @map("downloaded_at")

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  deliveries      InvestorPackDelivery[]

  @@index([templateId])
  @@index([vendorLeadId])
  @@index([dealId])
  @@index([generatedById])
  @@index([createdAt])
  @@map("investor_pack_generations")
}

// ============================================================================
// INVESTOR PACK DELIVERY & ACTIVITY TRACKING
// ============================================================================

// Track which investor received which investor pack
model InvestorPackDelivery {
  id String @id @default(uuid())

  // Links
  investorId String @map("investor_id")
  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  dealId String @map("deal_id")
  deal Deal @relation("InvestorPackDelivery", fields: [dealId], references: [id], onDelete: Cascade)

  generationId String? @map("generation_id")
  generation InvestorPackGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  // Delivery Details
  deliveryMethod String @default("email") @map("delivery_method") // email, download, manual
  recipientEmail String? @map("recipient_email")
  partNumber Int? @map("part_number") // For 4-part templates: 1, 2, 3, 4. NULL for single pack

  // Email Status
  emailStatus  String?  @default("pending") @map("email_status") // pending | sent | failed | no_smtp
  emailError   String?  @db.Text @map("email_error")

  // Tracking
  sentAt DateTime @default(now()) @map("sent_at")
  viewedAt DateTime? @map("viewed_at")
  downloadedAt DateTime? @map("downloaded_at")
  viewCount Int @default(0) @map("view_count")
  downloadCount Int @default(0) @map("download_count")

  // Notes
  notes String? @db.Text

  // Signed tokens for unauthenticated access (investors clicking email links)
  downloadToken String? @unique @map("download_token")
  interestToken String? @unique @map("interest_token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([investorId, dealId, generationId, partNumber])
  @@index([investorId])
  @@index([dealId])
  @@index([generationId])
  @@index([sentAt])
  @@index([partNumber])
  @@map("investor_pack_deliveries")
}

// Track all investor activities for pipeline management
model InvestorActivity {
  id String @id @default(uuid())

  // Links
  investorId String @map("investor_id")
  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  // Activity Details
  activityType InvestorActivityType @map("activity_type")
  description String? @db.Text

  // Related entities (optional)
  dealId String? @map("deal_id")
  reservationId String? @map("reservation_id")
  packDeliveryId String? @map("pack_delivery_id")

  // Metadata
  metadata Json? // Store additional data like previous/new values, etc.

  // Who triggered (if system or admin action)
  triggeredById String? @map("triggered_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([investorId])
  @@index([activityType])
  @@index([dealId])
  @@index([createdAt])
  @@map("investor_activities")
}

// ============================================================================
// PROPERTY SCRAPING MODELS
// ============================================================================

// Scraped property listing - raw data from Rightmove, Zoopla, OnTheMarket
model PropertyListing {
  id              String           @id @default(uuid())
  sourceId        String           @map("source_id")
  source          PropertySource
  category        PropertyCategory

  // Basic details
  title           String
  description     String           @db.Text
  propertyType    String           @map("property_type")
  propertySubType String?          @map("property_sub_type")
  bedrooms        Int              @default(0)
  bathrooms       Int              @default(0)

  // Pricing
  price           Decimal          @db.Decimal(12, 2)
  priceHistory    Json             @default("[]") @map("price_history")

  // Location
  address         Json

  // Size
  squareFeet      Int?             @map("square_feet")
  squareMeters    Int?             @map("square_meters")
  pricePerSqFt    Decimal?         @map("price_per_sq_ft") @db.Decimal(10, 2)

  // Commercial-specific (null for residential)
  commercialDetails Json?          @map("commercial_details")

  // BMV indicators
  bmvIndicators   Json             @default("{}") @map("bmv_indicators")
  isAmbiguous     Boolean          @default(false) @map("is_ambiguous")
  ambiguityReasons Json            @default("[]") @map("ambiguity_reasons")

  // ── Motivation scoring (Phase 2 Discover) ─────────────────────────────────
  motivationScore   Int?            @default(0)  @map("motivation_score")  // 0-100
  motivationSignals Json?           @default("[]") @map("motivation_signals") // [{name, points}]

  // ── Welsh / jurisdiction ────────────────────────────────────────────────────
  isWelsh           Boolean         @default(false) @map("is_welsh")
  jurisdiction      String?         // "WALES" | "ENGLAND"

  // ── Strategy viability (quick check, no API call required) ─────────────────
  strategyViability Json?           @default("{}") @map("strategy_viability") // {btl, brrr, hmo, flip}

  // ── Investor tracker stage ─────────────────────────────────────────────────
  trackerStage      String?         @map("tracker_stage") // null | watchlist | viewing | offer | rejected

  // Review queue
  reviewStatus    ReviewStatus     @default(PENDING) @map("review_status")
  reviewNotes     String?          @map("review_notes") @db.Text
  reviewedBy      String?          @map("reviewed_by")
  reviewedAt      DateTime?        @map("reviewed_at")

  // External data enrichment
  propertyDataAnalysis Json?       @map("property_data_analysis")
  aiAnalysis      Json?            @map("ai_analysis")

  // Media
  images          Json             @default("[]")
  floorPlans      Json             @default("[]") @map("floor_plans")

  // Agent info
  agent           Json             @default("{}")

  // Additional listing details
  keyFeatures     Json             @default("[]") @map("key_features")
  epcRating       String?          @map("epc_rating")
  tenure          String?          // FREEHOLD | LEASEHOLD | SHARE_OF_FREEHOLD | COMMONHOLD
  isChainFree     Boolean?         @map("is_chain_free")
  isNewBuild      Boolean?         @map("is_new_build")
  isRetirement    Boolean?         @map("is_retirement")
  leaseYearsRemaining Int?         @map("lease_years_remaining")
  groundRent      Decimal?         @map("ground_rent") @db.Decimal(10, 2)
  serviceCharge   Decimal?         @map("service_charge") @db.Decimal(10, 2)

  // Listing metadata
  listingUrl      String?          @map("listing_url") @db.Text
  listedDate      DateTime?        @map("listed_date")
  daysOnMarket    Int              @default(0) @map("days_on_market")
  status          ListingStatus    @default(FOR_SALE)
  scrapedAt       DateTime         @default(now()) @map("scraped_at")
  lastChecked     DateTime         @default(now()) @map("last_checked")
  checksum        String?
  isFavorited     Boolean          @default(false) @map("is_favorited")

  // Link to Deal (when promoted)
  dealId          String?          @map("deal_id")
  deal            Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // Relations
  exports          PropertyExport[]
  alertMatches     AlertMatch[]
  watchlistEntries WatchlistProperty[]
  scrapedPhotos    ScrapedPhoto[]

  @@unique([source, sourceId])
  @@index([category])
  @@index([reviewStatus])
  @@index([scrapedAt])
  @@index([status])
  @@index([dealId])
  @@index([isFavorited])
  @@map("property_listings")
}

// Scraper job tracking - each scraping run creates a job record
model ScraperJob {
  id              String         @id @default(uuid())
  source          PropertySource
  category        PropertyCategory?
  criteria        Json

  // Status
  status          JobStatus      @default(QUEUED)

  // Progress
  totalFound      Int            @default(0) @map("total_found")
  processed       Int            @default(0)
  successful      Int            @default(0)
  failed          Int            @default(0)

  // Errors
  errors          Json           @default("[]")
  propertiesFound String[]       @map("properties_found")

  // Timing
  startedAt       DateTime?      @map("started_at")
  completedAt     DateTime?      @map("completed_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([source])
  @@map("scraper_jobs")
}

// Global scraper settings - single row configuration
model ScraperSettings {
  id                    String   @id @default(uuid())
  enabled               Boolean  @default(true)
  scheduleType          String   @default("TWICE_DAILY") @map("schedule_type")

  // Source toggles
  rightmoveEnabled      Boolean  @default(true) @map("rightmove_enabled")
  zooplaEnabled         Boolean  @default(true) @map("zoopla_enabled")
  onthemarketEnabled    Boolean  @default(true) @map("onthemarket_enabled")
  primelocationEnabled  Boolean  @default(true) @map("primelocation_enabled")

  // Auto-analysis
  autoAnalysisEnabled   Boolean  @default(true) @map("auto_analysis_enabled")
  autoAnalysisThreshold Decimal? @map("auto_analysis_threshold") @db.Decimal(5, 2)

  // Review queue
  requireManualReview   Boolean  @default(true) @map("require_manual_review")

  // Rate limiting
  requestDelay          Int      @default(3000) @map("request_delay")
  maxConcurrent         Int      @default(2) @map("max_concurrent")

  // Search criteria (locations, price range, bedrooms, property types, etc.)
  searchCriteria        Json?    @map("search_criteria")

  // Proxy (optional)
  useProxy              Boolean  @default(false) @map("use_proxy")
  proxyUrl              String?  @map("proxy_url")

  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("scraper_settings")
}

// ─── AI Conversation Settings ─────────────────────────────────────────────────
// Singleton row controlling when the AI SMS agent auto-starts conversations.
// Each source can be toggled independently. Fetched/created on first use.
model AIConversationSettings {
  id String @id @default(uuid())

  // Global master switch — overrides all per-source toggles when OFF
  enabled              Boolean @default(true)

  // Per-source toggles
  facebookLeadsEnabled Boolean @default(true)  @map("facebook_leads_enabled")
  manualLeadsEnabled   Boolean @default(false) @map("manual_leads_enabled")
  apiLeadsEnabled      Boolean @default(false) @map("api_leads_enabled")

  // Conversation behaviour
  sendInitialGreeting  Boolean @default(true)  @map("send_initial_greeting")  // send opener or wait for vendor to initiate
  maxMessagesPerLead   Int     @default(20)     @map("max_messages_per_lead")  // safety cap

  // Audit
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedBy            String?  @map("updated_by")

  @@map("ai_conversation_settings")
}

// ─── Offer Calculator Config ──────────────────────────────────────────────────
// Singleton row that controls how the professional BMV offer calculator works.
// When enableStrategyMode = false, the legacy motivation-based calculation runs.
model OfferCalculatorConfig {
  id String @id @default(cuid())

  // Master toggle
  enableStrategyMode Boolean  @default(false) @map("enable_strategy_mode")

  // Strategy targeting
  activeStrategies String[] @default(["BuyHold", "BTL"]) @map("active_strategies")
  defaultStrategy  String   @default("BuyHold")          @map("default_strategy")

  // Base discount range (% off market value)
  baseDiscountMin Decimal @default(10) @map("base_discount_min") @db.Decimal(5, 2)
  baseDiscountMax Decimal @default(40) @map("base_discount_max") @db.Decimal(5, 2)

  // Risk adjustment factors (all increase the discount)
  poorConditionDiscount Decimal @default(10) @map("poor_condition_discount") @db.Decimal(5, 2)
  avgConditionDiscount  Decimal @default(3)  @map("avg_condition_discount")  @db.Decimal(5, 2)
  leaseholdDiscount     Decimal @default(5)  @map("leasehold_discount")      @db.Decimal(5, 2)
  longChainDiscount     Decimal @default(5)  @map("long_chain_discount")     @db.Decimal(5, 2)
  shortChainDiscount    Decimal @default(2)  @map("short_chain_discount")    @db.Decimal(5, 2)

  // Demand reduction (reduces the discount when area has strong demand)
  highDemandThreshold Int     @default(8) @map("high_demand_threshold")
  highDemandReduction Decimal @default(5) @map("high_demand_reduction") @db.Decimal(5, 2)

  // Strategy-specific targets
  flipMarketValuePct Decimal @default(70) @map("flip_market_value_pct") @db.Decimal(5, 2)
  brrLtvPercent      Decimal @default(75) @map("brr_ltv_percent")       @db.Decimal(5, 2)
  buyHoldMinYield    Decimal @default(8)  @map("buy_hold_min_yield")    @db.Decimal(5, 2)
  btlMinYield        Decimal @default(7)  @map("btl_min_yield")         @db.Decimal(5, 2)

  // Validation thresholds
  minBmvPercentage   Decimal @default(15)    @map("min_bmv_percentage")   @db.Decimal(5, 2)
  minProfitPotential Decimal @default(10000) @map("min_profit_potential") @db.Decimal(12, 2)

  // Investor constraint: offer must always be at least this % below asking price
  // Prevents offers at or above asking even when the deal is already priced BMV
  minDiscountFromAsking Decimal @default(5) @map("min_discount_from_asking") @db.Decimal(5, 2)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("offer_calculator_config")
}

// ============================================================================
// HM LAND REGISTRY — PRICE PAID DATA (PPD)
// ============================================================================

// Deduplicated street → postcode mapping sourced from the PPD CSV.
// One row per (streetNorm, postcode) pair to keep the table compact.
// Used for postcode resolution when CCOD/OCOD has no matching record.
model PricePaidAddress {
  id         String @id @default(cuid())
  street     String @db.Text         // raw street name from PPD (field index 9)
  streetNorm String @map("street_norm") // lowercase, trimmed, collapsed spaces
  postcode   String                   // full postcode e.g. "SA6 8DU"
  town       String?                  // field index 11 (district/town)

  @@unique([streetNorm, postcode])
  @@index([streetNorm])
  @@index([postcode])
  @@map("price_paid_addresses")
}

// Import job tracking for PPD CSV downloads
model PricePaidImport {
  id              String    @id @default(uuid())
  year            Int                             // e.g. 2024 (or 0 = "full" all years)
  status          String    @default("PENDING")   // PENDING | RUNNING | PAUSED | COMPLETED | FAILED | CANCELLED
  recordsRead     Int       @default(0) @map("records_read")
  recordsInserted Int       @default(0) @map("records_inserted")
  errorMessage    String?   @map("error_message") @db.Text
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([year])
  @@map("price_paid_imports")
}

// Export tracking - records of CSV/Excel/JSON exports
model PropertyExport {
  id          String           @id @default(uuid())
  propertyId  String?          @map("property_id")
  property    PropertyListing? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  format      ExportFormat
  filters     Json?
  recordCount Int              @default(0) @map("record_count")
  fileUrl     String?          @map("file_url")
  exportedBy  String?          @map("exported_by")
  exportedAt  DateTime         @default(now()) @map("exported_at")

  @@index([exportedAt])
  @@map("property_exports")
}

// ============================================================================
// HM LAND REGISTRY — COMPANY OWNERSHIP DATA (CCOD / OCOD)
// ============================================================================

// Company ownership record sourced from CCOD (UK companies) or OCOD (overseas companies)
model CompanyOwnership {
  id                  String   @id @default(uuid())
  titleNumber         String   @unique @map("title_number")
  tenure              String?  // FREEHOLD | LEASEHOLD
  propertyAddress     String   @map("property_address") @db.Text
  postcode            String?
  postcodeNormalized  String?  @map("postcode_normalized") // uppercase, no spaces e.g. "N11AA"

  companyName         String   @map("company_name")
  companyRegNumber    String?  @map("company_reg_number")
  companyAddress      String?  @map("company_address") @db.Text
  proprietorCategory  String?  @map("proprietor_category") // e.g. "Limited Company", "Public Limited Company"
  countryIncorporated String?  @map("country_incorporated")
  isOverseas          Boolean  @default(false) @map("is_overseas")

  dateProprietary     String?  @map("date_proprietary") // raw string from CSV e.g. "20/05/2015"
  pricePaid           Decimal? @map("price_paid") @db.Decimal(12, 2)

  importedAt          DateTime @default(now()) @map("imported_at")

  @@index([postcodeNormalized])
  @@index([companyRegNumber])
  @@index([isOverseas])
  @@map("company_ownership")
}

// Import job tracking for Land Registry dataset downloads
model LandRegistryImport {
  id              String    @id @default(uuid())
  datasetType     String    @map("dataset_type")  // "CCOD" | "OCOD"
  status          String    @default("PENDING")   // PENDING | RUNNING | PAUSED | COMPLETED | FAILED | CANCELLED
  recordsImported Int       @default(0) @map("records_imported")
  recordsTotal    Int       @default(0) @map("records_total")
  errorMessage    String?   @map("error_message") @db.Text
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  pausedAt        DateTime? @map("paused_at")
  resumedAt       DateTime? @map("resumed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  
  // Progress tracking
  bytesDownloaded String?   @map("bytes_downloaded") // Store as string for large numbers
  bytesTotal      String?   @map("bytes_total") // Store as string for large numbers
  downloadSpeed   Decimal?  @map("download_speed") @db.Decimal(10, 2) // bytes per second
  estimatedTimeRemaining Int? @map("estimated_time_remaining") // seconds
  
  // Resume support
  lastProcessedPosition String? @map("last_processed_position") // byte position in file (as string)
  resumeToken          String?  @map("resume_token") @db.Text // token for resuming download
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([datasetType, createdAt])
  @@index([status])
  @@map("land_registry_imports")
}

// ─── Sourcing Alerts ──────────────────────────────────────────────────────────

model SourcingAlert {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  name          String?
  address       String
  radius        String       // e.g. "+1km", "+5km", "+10km", "+20km", "+40km"
  latitude      Float?
  longitude     Float?
  minPrice      Int?         @map("min_price")
  maxPrice      Int?         @map("max_price")
  minBedrooms   Int?         @map("min_bedrooms")
  maxBedrooms   Int?         @map("max_bedrooms")
  propertyTypes String[]     @map("property_types")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id])
  matches       AlertMatch[]

  @@index([userId])
  @@index([isActive])
  @@map("sourcing_alerts")
}

model AlertMatch {
  id                  String          @id @default(cuid())
  alertId             String          @map("alert_id")
  scrapedPropertyId   String          @map("scraped_property_id")
  matchedAt           DateTime        @default(now()) @map("matched_at")
  notifiedEmail       Boolean         @default(false) @map("notified_email")
  notifiedSms         Boolean         @default(false) @map("notified_sms")
  notifiedInApp       Boolean         @default(false) @map("notified_in_app")

  alert           SourcingAlert   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  propertyListing PropertyListing @relation(fields: [scrapedPropertyId], references: [id], onDelete: Cascade)

  @@unique([alertId, scrapedPropertyId])
  @@index([alertId])
  @@map("alert_matches")
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  priceIncrease         Boolean  @default(true) @map("price_increase")
  priceDecrease         Boolean  @default(true) @map("price_decrease")
  auctionReminder7Days  Boolean  @default(true) @map("auction_reminder_7_days")
  auctionReminder3Days  Boolean  @default(true) @map("auction_reminder_3_days")
  auctionReminder1Day   Boolean  @default(true) @map("auction_reminder_1_day")
  newPropertyMatch      Boolean  @default(true) @map("new_property_match")
  deliveryEmail         Boolean  @default(true) @map("delivery_email")
  deliverySms           Boolean  @default(false) @map("delivery_sms")
  deliveryInApp         Boolean  @default(true) @map("delivery_in_app")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user  User @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model WatchlistProperty {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  scrapedPropertyId String          @map("scraped_property_id")
  lastKnownPrice    Int             @map("last_known_price")
  addedAt           DateTime        @default(now()) @map("added_at")

  user            User            @relation(fields: [userId], references: [id])
  propertyListing PropertyListing @relation(fields: [scrapedPropertyId], references: [id], onDelete: Cascade)

  @@unique([userId, scrapedPropertyId])
  @@index([userId])
  @@map("watchlist_properties")
}


model UserTheme {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_themes")
}

// ============================================================================
// PHOTO ANALYSIS MODELS
// ============================================================================

model PropertyPhoto {
  id           String      @id @default(cuid())
  vendorLeadId String      @map("vendor_lead_id")
  vendorLead   VendorLead  @relation(fields: [vendorLeadId], references: [id], onDelete: Cascade)

  source       PhotoSource
  s3Key        String      @map("s3_key")
  url          String      @db.Text
  filename     String?
  mimeType     String?     @map("mime_type")
  sizeBytes    Int?        @map("size_bytes")

  // AI Analysis
  aiRoomType       String?  @map("ai_room_type")
  aiCondition      String?  @map("ai_condition")
  aiConditionScore Int?     @map("ai_condition_score")
  aiIssues         String[] @map("ai_issues")
  aiDescription    String?  @map("ai_description") @db.Text
  aiAnalysedAt     DateTime? @map("ai_analysed_at")
  aiRawResponse    Json?    @map("ai_raw_response")

  sortOrder    Int      @default(0) @map("sort_order")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([vendorLeadId])
  @@index([source])
  @@map("property_photos")
}

model ScrapedPhoto {
  id                 String          @id @default(cuid())
  propertyListingId  String          @map("property_listing_id")
  propertyListing    PropertyListing @relation(fields: [propertyListingId], references: [id], onDelete: Cascade)

  url              String   @db.Text
  sortOrder        Int      @default(0) @map("sort_order")

  // AI Analysis
  aiRoomType       String?  @map("ai_room_type")
  aiCondition      String?  @map("ai_condition")
  aiConditionScore Int?     @map("ai_condition_score")
  aiIssues         String[] @map("ai_issues")
  aiDescription    String?  @map("ai_description") @db.Text
  aiAnalysedAt     DateTime? @map("ai_analysed_at")

  @@index([propertyListingId])
  @@map("scraped_photos")
}

// ============================================================================
// IN-APP NOTIFICATIONS
// ============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Type & grouping
  type      String   // stuck_lead | lr_stale | lr_import | alert_match | vendor_reply | offer_accepted | offer_rejected | high_distress | price_reduction
  category  String   // lead | data | ai | team

  // Content
  title     String
  body      String   @db.Text
  link      String?  // Deep-link path (e.g. /vendor-pipeline?lead=xxx)

  // State
  read      Boolean  @default(false)
  meta      Json?    @default("{}") // Type-specific payload

  // Deduplication — prevents duplicate notifications per user
  dedupeKey String?  @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, dedupeKey])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================================================
// LEAD NOTES
// ============================================================================

model LeadNote {
  id           String     @id @default(cuid())
  vendorLeadId String     @map("vendor_lead_id")
  vendorLead   VendorLead @relation(fields: [vendorLeadId], references: [id], onDelete: Cascade)

  content      String     @db.Text
  createdById  String?    @map("created_by_id")
  // Denormalised author name so notes remain readable after user deletion
  createdByName String?   @map("created_by_name")

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([vendorLeadId])
  @@index([createdAt])
  @@map("lead_notes")
}
