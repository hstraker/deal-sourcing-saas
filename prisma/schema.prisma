model VendorLead {
  id String @id @default(uuid())

  // Lead Source
  facebookLeadId String? @unique @map("facebook_lead_id")
  leadSource     String  @default("facebook_ads") @map("lead_source")
  campaignId     String? @map("campaign_id")

  // Vendor Information
  vendorName    String  @map("vendor_name")
  vendorPhone   String  @map("vendor_phone")
  vendorEmail   String? @map("vendor_email")
  vendorAddress String? @map("vendor_address") @db.Text

  // Property Details
  propertyAddress       String?            @map("property_address") @db.Text
  propertyPostcode      String?            @map("property_postcode")
  askingPrice           Decimal?           @map("asking_price") @db.Decimal(12, 2)
  propertyType          String?            @map("property_type")
  bedrooms              Int?
  bathrooms             Int?
  squareFeet            Int?               @map("square_feet")
  condition             PropertyCondition?
  estimatedMonthlyRent  Decimal?           @map("estimated_monthly_rent") @db.Decimal(10, 2)
  estimatedAnnualRent   Decimal?           @map("estimated_annual_rent") @db.Decimal(10, 2)
  rentPerSqFt           Decimal?           @map("rent_per_sq_ft") @db.Decimal(5, 2)
  localAverageRent      Decimal?           @map("local_average_rent") @db.Decimal(10, 2)
  rentConfidence        String?            @map("rent_confidence") // 'HIGH', 'MEDIUM', 'LOW'

  // EPC Data (from PropertyData energy-efficiency API)
  epcRating         String?   @map("epc_rating")           // A | B | C | D | E | F | G
  epcScore          Int?      @map("epc_score")             // 0–100
  epcInspectionDate DateTime? @map("epc_inspection_date")  // Date of last EPC inspection

  // Workflow Status
  pipelineStage     PipelineStage @default(NEW_LEAD) @map("pipeline_stage")
  conversationState Json?         @default("{}") @map("conversation_state")

  // AI Conversation Data
  aiConversationHistory Json?          @default("[]") @map("ai_conversation_history")
  motivationScore       Int?           @map("motivation_score")
  urgencyLevel          UrgencyLevel?  @map("urgency_level")
  reasonForSelling      ReasonForSale? @map("reason_for_selling")
  timelineDays          Int?           @map("timeline_days")
  competingOffers       Boolean        @default(false) @map("competing_offers")

  // Deal Validation
  bmvScore             Decimal?  @map("bmv_score") @db.Decimal(5, 2)
  estimatedMarketValue Decimal?  @map("estimated_market_value") @db.Decimal(12, 2)
  estimatedRefurbCost  Decimal?  @map("estimated_refurb_cost") @db.Decimal(12, 2)
  profitPotential      Decimal?  @map("profit_potential") @db.Decimal(12, 2)
  validationPassed     Boolean?  @map("validation_passed")
  validationNotes      String?   @map("validation_notes") @db.Text
  validatedAt          DateTime? @map("validated_at")

  // Comparables Tracking
  comparablesCount        Int?      @default(0) @map("comparables_count")
  comparablesFetchedAt    DateTime? @map("comparables_fetched_at")
  comparablesSearchRadius Int?      @default(3) @map("comparables_search_radius")
  avgComparablePrice      Decimal?  @map("avg_comparable_price") @db.Decimal(10, 2)
  comparablesConfidence   String?   @map("comparables_confidence") // 'HIGH', 'MEDIUM', 'LOW'

  // Offer Engine — persisted assumptions (sourcer edits from the modal left panel)
  calculatorAssumptions Json? @map("calculator_assumptions")

  // AI Negotiation Coach — cached playbook (regenerated on demand)
  negotiationCoach   Json?     @map("negotiation_coach")
  negotiationCoachAt DateTime? @map("negotiation_coach_at")

  // Offer Management
  offerAmount        Decimal?  @map("offer_amount") @db.Decimal(12, 2)
  offerPercentage    Decimal?  @map("offer_percentage") @db.Decimal(5, 2)
  offerSentAt        DateTime? @map("offer_sent_at")
  offerAcceptedAt    DateTime? @map("offer_accepted_at")
  offerRejectedAt    DateTime? @map("offer_rejected_at")
  rejectionReason    String?   @map("rejection_reason") @db.Text
  retryCount         Int       @default(0) @map("retry_count")
  nextRetryAt        DateTime? @map("next_retry_at")
  offerTokenVersion  Int       @default(0) @map("offer_token_version")

  // Retry Tracking
  videoSent   Boolean   @default(false) @map("video_sent")
  videoSentAt DateTime? @map("video_sent_at")
  videoUrl    String?   @map("video_url") @db.Text

  // Solicitor Details
  solicitorName            String?   @map("solicitor_name")
  solicitorFirm            String?   @map("solicitor_firm")
  solicitorPhone           String?   @map("solicitor_phone")
  solicitorEmail           String?   @map("solicitor_email")
  lockoutAgreementSent     Boolean   @default(false) @map("lockout_agreement_sent")
  lockoutAgreementSentAt   DateTime? @map("lockout_agreement_sent_at")
  lockoutAgreementSigned   Boolean   @default(false) @map("lockout_agreement_signed")
  lockoutAgreementSignedAt DateTime? @map("lockout_agreement_signed_at")
  lockoutAgreementS3Key    String?   @map("lockout_agreement_s3_key")

  // Completion Timeline (set after offer accepted)
  targetExchangeDate    DateTime? @map("target_exchange_date")
  targetCompletionDate  DateTime? @map("target_completion_date")
  solicitorInstructedAt DateTime? @map("solicitor_instructed_at")

  // Postcode resolution tracking
  propertyPostcodeSource String? @map("property_postcode_source") // "land_registry" | "postcodes_io" | "manual"
  propertyPostcodeFixed  Boolean @default(false) @map("property_postcode_fixed") // true = was corrected automatically

  // Investment Strategy (for offer calculator)
  investmentStrategy  String? @map("investment_strategy")   // "Flip" | "BRR" | "BuyHold" | "BTL"
  chainStatus         String? @map("chain_status")          // "NoChain" | "ShortChain" | "LongChain"
  postcodeDemandScore Int?    @map("postcode_demand_score") // 1-10
  tenureType          String? @map("tenure_type")           // "Freehold" | "Leasehold"
  leaseholdData       Json?   @map("leasehold_data")         // LeaseholdData JSON object

  // Link to Deal
  dealId String? @map("deal_id")

  // Investor Reservation Link — set when an investor locks out / completes a reservation on the linked deal
  reservedByInvestorId String?   @map("reserved_by_investor_id") // Investor.id
  reservedAt           DateTime? @map("reserved_at")

  // Linked solicitor/contact (from shared Contact registry — overrides investor default per deal)
  solicitorId String?  @map("solicitor_id")
  solicitor   Contact? @relation("VendorLeadContact", fields: [solicitorId], references: [id])

  // Investor Pack Tracking
  investorPackGenerationCount Int       @default(0) @map("investor_pack_generation_count")
  lastInvestorPackGeneratedAt DateTime? @map("last_investor_pack_generated_at")

  // Test / Simulator mode — null on real leads
  isTest       Boolean @default(false) @map("is_test")
  testScenario String? @map("test_scenario") // MockScenarioId | null

  // Portal Check Cache — latest check summary for quick display on Kanban / list views
  latestCheckRisk  String?   @map("latest_check_risk")   // "clear" | "caution" | "red_flag"
  latestCheckedAt  DateTime? @map("latest_checked_at")

  // Processing pipeline status
  processingStatus  ProcessingStatus @default(PENDING) @map("processing_status")
  postcodeOriginal  String?          @map("postcode_original")
  bmvValidatedAt    DateTime?        @map("bmv_validated_at")
  portalCheckedAt   DateTime?        @map("portal_checked_at")
  archivedAt        DateTime?        @map("archived_at")

  // Timestamps
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  lastContactAt         DateTime? @map("last_contact_at")
  conversationStartedAt DateTime? @map("conversation_started_at")
  preferredChannel      String    @default("sms") @map("preferred_channel")  // "sms" | "whatsapp"
  dealClosedAt          DateTime? @map("deal_closed_at")

  // ── Sourcing Fee & Deal P&L ──────────────────────────────────────────────
  sourcingFee              Decimal?  @db.Decimal(10, 2) @map("sourcing_fee")
  sourcingFeeType          String?   @map("sourcing_fee_type")   // "fixed" | "percent"
  sourcingFeePercent       Decimal?  @db.Decimal(5, 2)  @map("sourcing_fee_percent")
  coSourcingPartner        String?   @map("co_sourcing_partner")
  coSourcingFeePercent     Decimal?  @db.Decimal(5, 2)  @map("co_sourcing_fee_percent")
  acquisitionCostSurvey    Decimal?  @db.Decimal(10, 2) @map("acquisition_cost_survey")
  acquisitionCostLegal     Decimal?  @db.Decimal(10, 2) @map("acquisition_cost_legal")
  acquisitionCostMarketing Decimal?  @db.Decimal(10, 2) @map("acquisition_cost_marketing")
  acquisitionCostOther     Decimal?  @db.Decimal(10, 2) @map("acquisition_cost_other")
  sourcingFeeInvoicedAt    DateTime? @map("sourcing_fee_invoiced_at")
  sourcingFeePaidAt        DateTime? @map("sourcing_fee_paid_at")

  // ── Acquisition Cost Overrides (used in All-In Cost calculator) ──────────
  sdltBuyerType            String?   @map("sdlt_buyer_type")  // SdltBuyerType
  solicitorFeesOverride    Decimal?  @db.Decimal(10, 2) @map("solicitor_fees_override")
  surveyFeeOverride        Decimal?  @db.Decimal(10, 2) @map("survey_fee_override")
  bridgingCostOverride     Decimal?  @db.Decimal(10, 2) @map("bridging_cost_override")
  insuranceOverride        Decimal?  @db.Decimal(10, 2) @map("insurance_override")

  // Photo Analysis
  photoUploadToken        String?             @unique @map("photo_upload_token")
  photoUploadExpiresAt    DateTime?           @map("photo_upload_expires_at")
  photoConditionScore     Int?                @map("photo_condition_score")
  photoConditionOverride  PropertyCondition?  @map("photo_condition_override")
  photoAnalysisStatus     PhotoAnalysisStatus @default(pending) @map("photo_analysis_status")
  photoAnalysisCompletedAt DateTime?          @map("photo_analysis_completed_at")
  photoAnalysisNotes      String?             @map("photo_analysis_notes") @db.Text

  // Street View AI Analysis (persisted after Claude Vision analyses the frontage)
  streetViewAnalysis   Json?     @map("street_view_analysis")
  streetViewAnalysedAt DateTime? @map("street_view_analysed_at")

  // Property History Intelligence (cached after first fetch)
  propertyHistory   Json?     @map("property_history")
  propertyHistoryAt DateTime? @map("property_history_at")

  // Flood Risk (persisted after EA Flood Monitoring API check)
  floodRiskZone      String?   @map("flood_risk_zone")       // "zone1" | "zone2" | "zone3" | "unknown"
  floodRiskCheckedAt DateTime? @map("flood_risk_checked_at")

  // Relations
  smsMessages          SMSMessage[]
  pipelineEvents       PipelineEvent[]
  offerRetries         OfferRetry[]
  comparableProperties ComparableProperty[]
  comparablesSnapshots ComparablesSnapshot[]
  portalChecks         VendorPropertyCheck[]
  photos               PropertyPhoto[]
  leadNotes            LeadNote[]

  @@index([pipelineStage])
  @@index([createdAt])
  @@index([vendorPhone])
  @@index([facebookLeadId])
  @@index([dealId])
  @@index([motivationScore])
  @@index([nextRetryAt])
  @@index([latestCheckRisk])
  @@index([solicitorId])
  @@map("vendor_leads")
}

model VendorPropertyCheck {
  id           String     @id @default(cuid())
  vendorLeadId String     @map("vendor_lead_id")
  vendorLead   VendorLead @relation(fields: [vendorLeadId], references: [id], onDelete: Cascade)

  triggeredBy String   @map("triggered_by") // "auto" | "manual"
  triggeredAt DateTime @default(now()) @map("triggered_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  // Test mode
  isMockData     Boolean @default(false) @map("is_mock_data")
  mockScenarioId String? @map("mock_scenario_id") // MockScenarioId used, for audit

  // Raw API responses (stored as JSON for debugging / re-processing)
  portalCheckRaw    Json? @map("portal_check_raw")
  ownershipCheckRaw Json? @map("ownership_check_raw")

  // Computed results
  overallRisk       String @default("clear") @map("overall_risk") // "clear" | "caution" | "red_flag"
  riskScore         Int    @default(0) @map("risk_score")         // 0-100
  summaryFlags      Json   @default("[]") @map("summary_flags")   // PortalFlag[]
  recommendedAction String? @map("recommended_action")

  // Execution status
  checkStatus  String  @default("pending") @map("check_status") // "pending" | "running" | "success" | "failed"
  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vendorLeadId])
  @@index([overallRisk])
  @@index([checkStatus])
  @@index([triggeredAt])
  @@map("vendor_property_checks")
